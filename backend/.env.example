# Скопируйте в .env и заполните. Файл .env НЕ коммитить.

# Ссылка с кнопки «Открыть GET для DEV» из задания.
# Без неё сервер работает на тестовых данных data/mock/DEV.json
CQA_API_URL=

# Какой ИИ оценивает: claude | deepseek | mock
# (если не указано — claude, если есть ANTHROPIC_API_KEY, иначе deepseek, если есть DEEPSEEK_API_KEY, иначе mock)
# CQA_EVALUATOR=deepseek

# --- Claude ---
ANTHROPIC_API_KEY=
# CQA_MODEL=claude-opus-5-5        # или claude-sonnet-5-5 / claude-haiku-5-5
# CQA_EFFORT=medium

# --- DeepSeek (platform.deepseek.com → API Keys) ---
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash    # или deepseek-v4-pro
# DEEPSEEK_THINKING=disabled       # enabled — с рассуждениями: точнее, но медленнее и дороже

# Сколько раз оценивать каждый диалог (голосование большинством)
# CQA_VOTES=3

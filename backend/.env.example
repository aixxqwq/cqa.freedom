# Скопируйте в .env и заполните. Файл .env НЕ коммитить.

# Ссылка с кнопки «Открыть GET для DEV» из задания.
# Без неё сервер работает на тестовых данных data/mock/DEV.json
CQA_API_URL=

# Ключ Claude API. Без него включается mock-оценщик (эвристика без ИИ).
ANTHROPIC_API_KEY=

